# Copy to .env for local runs. Never commit the real file.

# Output of `garmin-mcp-login` (preferred). Leave empty if you use a local token dir.
GARMIN_TOKENS=
# Fallback only; fails on accounts with MFA.
GARMIN_EMAIL=
GARMIN_PASSWORD=
GARMIN_TOKEN_DIR=~/.garmin-tokens

# Allow create/schedule/delete workouts, rename activities, log weight.
GARMIN_ALLOW_WRITES=false
GARMIN_CACHE_TTL=300

# HTTP mode only
MCP_AUTH_SECRET=
# Optional: your public hostname, enables Host header checks (e.g. garmin-mcp.fly.dev)
MCP_ALLOWED_HOSTS=
PORT=8000
